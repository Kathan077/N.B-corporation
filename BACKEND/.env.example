PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxxx.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here

# Email Notification Settings (Sends inquiry to nb2corporation@gmail.com)
TARGET_EMAIL=nb2corporation@gmail.com
EMAIL_USER=nb2corporation@gmail.com
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_gmail_app_password
